<UserControl x:Class="PulsePal.Views.ServicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="900">
    <Grid Margin="24,14,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Heading ===================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="SERVICE HATCH / LOCAL"
                           Style="{StaticResource Eyebrow}"
                           Foreground="{StaticResource Lime}"
                           FontSize="9" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Services"
                               Style="{StaticResource PageTitle}"
                               FontSize="34" />
                    <Path Data="M4,5 L20,5 L20,19 L4,19 Z M8,9 L16,9 L16,15 L8,15 Z M12,3 L12,5 M12,19 L12,21"
                          Stroke="{StaticResource Lime}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Width="24"
                          Height="24"
                          Stretch="Uniform"
                          Margin="12,0,0,3"
                          VerticalAlignment="Bottom" />
                </StackPanel>
                <TextBlock Text="Background helpers, with a guarded hand on the switch."
                           Style="{StaticResource MutedText}"
                           FontSize="12.5"
                           Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        Margin="14,0,0,2">
                <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Lime}" Margin="0,0,6,0">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.35"
                                                             Duration="0:0:1.2"
                                                             AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="{Binding LastUpdatedText}"
                                   Style="{StaticResource Eyebrow}"
                                   FontSize="8.5"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                            <Setter Property="Background" Value="{StaticResource AmberSoft}" />
                            <Setter Property="BorderBrush" Value="{StaticResource Amber}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource LimeSoft}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Lime}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StateText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
                                <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                <Setter Property="FontSize" Value="8.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdministrator}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Lime}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ===================== Read-only banner ===================== -->
        <Border Grid.Row="1"
                Background="{StaticResource AmberSoft}"
                BorderBrush="{StaticResource Amber}"
                BorderThickness="2"
                CornerRadius="12,7,14,9"
                Padding="14,11"
                Margin="0,11,0,0"
                Visibility="{Binding ShowElevationBanner, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="36"
                        Height="36"
                        Background="{StaticResource CocoaDeep}"
                        BorderBrush="{StaticResource Amber}"
                        BorderThickness="1.5"
                        CornerRadius="8,5,10,6"
                        VerticalAlignment="Center">
                    <TextBlock Text="!"
                               Style="{StaticResource DisplayText}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource Amber}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="The service hatch is locked"
                               Style="{StaticResource BodyText}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Windows only lets administrator processes start or stop services. PulsePal stays open in read-only mode."
                               Style="{StaticResource SmallMuted}"
                               FontSize="9.5"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource AmberButton}"
                        Content="RESTART ELEVATED"
                        Command="{Binding ElevateCommand}"
                        MinWidth="164"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ===================== Toolbar ===================== -->
        <Grid Grid.Row="2" Margin="0,10,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="300" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBox Style="{StaticResource SearchBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Filter by service name, status, or start type"
                         Padding="11,6" />
                <TextBlock Text="search services, status, or start type"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SmallMuted}">
                            <Setter Property="FontSize" Value="10.5" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}"
                        Content="REFRESH"
                        Command="{Binding RefreshCommand}"
                        Padding="12,7"
                        FontSize="11"
                        Margin="0,0,8,0"
                        ToolTip="Read the service table again" />
                <Button Style="{StaticResource LimeButton}"
                        Content="START SELECTED"
                        Command="{Binding StartSelectedCommand}"
                        Padding="12,7"
                        FontSize="11"
                        Margin="0,0,8,0"
                        ToolTip="Start the selected service after a confirmation" />
                <Button Style="{StaticResource DangerButton}"
                        Content="STOP SELECTED"
                        Command="{Binding StopSelectedCommand}"
                        Padding="12,7"
                        FontSize="11"
                        ToolTip="Stop the selected service after a confirmation" />
            </StackPanel>
        </Grid>

        <!-- ===================== Service table ===================== -->
        <Border Grid.Row="3"
                Style="{StaticResource StickerCard}"
                Background="{StaticResource Panel}"
                CornerRadius="9,15,11,18"
                Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3.2*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.0*" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SERVICE" Style="{StaticResource Eyebrow}" FontSize="8.5" Foreground="{StaticResource Muted}" />
                    <TextBlock Grid.Column="1" Text="STATUS" Style="{StaticResource Eyebrow}" FontSize="8.5" Foreground="{StaticResource Muted}" />
                    <TextBlock Grid.Column="2" Text="START" Style="{StaticResource Eyebrow}" FontSize="8.5" Foreground="{StaticResource Muted}" />
                </Grid>

                <Grid Grid.Row="1">
                    <ListBox ItemsSource="{Binding ItemsView}"
                             SelectedItem="{Binding SelectedService, Mode=TwoWay}"
                             SelectionMode="Single"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row"
                                                    Background="Transparent"
                                                    Padding="0,1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelHover}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource PanelHover}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Name}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="27" />
                                        <RowDefinition Height="1" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3.2*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.0*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>

                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="3"
                                                Height="13"
                                                CornerRadius="1,2,1,2"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Faint}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="running">
                                                            <Setter Property="Background" Value="{StaticResource Lime}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="paused">
                                                            <Setter Property="Background" Value="{StaticResource Sky}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusKind}" Value="pending">
                                                            <Setter Property="Background" Value="{StaticResource Amber}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="9,0,0,0">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Style="{StaticResource BodyText}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Name}"
                                                       Style="{StaticResource MonoText}"
                                                       FontSize="8"
                                                       Foreground="{StaticResource Faint}"
                                                       Margin="8,1,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding StatusText}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="running">
                                                        <Setter Property="Foreground" Value="{StaticResource Lime}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="paused">
                                                        <Setter Property="Foreground" Value="{StaticResource Sky}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusKind}" Value="pending">
                                                        <Setter Property="Foreground" Value="{StaticResource Amber}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StartTypeText}"
                                               Style="{StaticResource MonoText}"
                                               FontSize="9"
                                               Foreground="{StaticResource Faint}"
                                               VerticalAlignment="Center" />

                                    <Path Grid.Column="3"
                                          Data="M4,7 L4,5.7 C4,3.7 5.6,2.1 7.6,2.1 C9.6,2.1 11.2,3.7 11.2,5.7 L11.2,7 M3,7 L12.2,7 L12.2,13.4 L3,13.4 Z"
                                          Stroke="{StaticResource Faint}"
                                          StrokeThickness="1.2"
                                          Width="9"
                                          Height="11"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding IsProtected, Converter={StaticResource BoolToVisibility}}"
                                          ToolTip="Protected by PulsePal / do not touch" />

                                    <Rectangle Grid.Row="1"
                                               Grid.ColumnSpan="4"
                                               Style="{StaticResource DashRule}"
                                               Opacity="0.55" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="No services answered the roll call."
                               FontSize="11"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SmallMuted}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ActionHint}"
                               Style="{StaticResource SmallMuted}"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusText}"
                               Style="{StaticResource MonoText}"
                               FontSize="8.5"
                               Foreground="{StaticResource Faint}"
                               TextTrimming="CharacterEllipsis"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
