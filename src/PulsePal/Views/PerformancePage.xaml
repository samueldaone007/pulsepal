<UserControl x:Class="PulsePal.Views.PerformancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PulsePal.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="PerfCardTitle" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PerfDetail" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource Cream}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PerfSubDetail" TargetType="TextBlock" BasedOn="{StaticResource SmallMuted}">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PerfCard" TargetType="Border" BasedOn="{StaticResource StickerCardHover}">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="CornerRadius" Value="14,9,16,11" />
            <Setter Property="Padding" Value="15,12" />
            <Setter Property="Height" Value="200" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch"
                  PanningMode="VerticalOnly">
        <Grid Margin="24,14,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="BIG CHARTS / 60 S WINDOW"
                               Style="{StaticResource Eyebrow}"
                               Foreground="{StaticResource Sky}"
                               FontSize="9.5" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="Performance"
                                   Style="{StaticResource PageTitle}"
                                   FontSize="38" />
                        <Path Data="M1,10 L14,8 L26,12 L38,9 L48,13"
                              Stroke="{StaticResource Sky}"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="52"
                              Height="16"
                              Stretch="Fill"
                              Margin="12,0,0,4"
                              VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="Four vitals, one minute, and enough room to see the shape."
                               Style="{StaticResource MutedText}"
                               FontSize="13"
                               Margin="0,3,0,0" />
                    <TextBlock Text="{Binding MachineText}"
                               Style="{StaticResource SmallMuted}"
                               FontSize="10.5"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="720"
                               HorizontalAlignment="Left"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Margin="14,0,0,3">
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Sky}" Margin="0,0,6,0">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.35"
                                                                 Duration="0:0:1.2"
                                                                 AutoReverse="True" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="{Binding LastUpdatedText}"
                                       Style="{StaticResource Eyebrow}"
                                       FontSize="8.5"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Chip}"
                            Background="{StaticResource SkySoft}"
                            BorderBrush="{StaticResource Sky}"
                            ToolTip="{Binding WindowDescription}">
                        <TextBlock Text="{Binding WindowText}"
                                   Style="{StaticResource Eyebrow}"
                                   FontSize="8.5"
                                   Foreground="{StaticResource Sky}" />
                    </Border>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- CPU -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource PerfCard}"
                        Margin="0,0,14,14"
                        RenderTransformOrigin="0.5,0.5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" Background="{StaticResource Amber}" CornerRadius="2,1,2,1" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="CPU / LOAD" Style="{StaticResource PerfCardTitle}" Foreground="{StaticResource Amber}" />
                            </StackPanel>
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Padding="6,1" Background="Transparent" BorderBrush="{StaticResource Hairline}">
                                <TextBlock Text="{Binding CpuMetaText}" Style="{StaticResource MonoText}" FontSize="8" Foreground="{StaticResource Faint}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,5,0,0">
                            <controls:AnimatedNumber Value="{Binding Cpu.Value}"
                                                     ValueFormat="{Binding Cpu.ValueFormat}"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     FontWeight="Bold"
                                                     FontSize="44"
                                                     LineHeight="44"
                                                     Foreground="{StaticResource Amber}" />
                            <TextBlock Text="%"
                                       Style="{StaticResource UnitText}"
                                       Foreground="{StaticResource Amber}"
                                       FontSize="14"
                                       Opacity="0.8" />
                        </StackPanel>

                        <controls:Sparkline Grid.Row="2"
                                            Values="{Binding Cpu.History}"
                                            Stroke="{StaticResource Amber}"
                                            FixedMaximum="100"
                                            Height="68"
                                            Margin="0,5,0,2" />

                        <TextBlock Grid.Row="3"
                                   Text="{Binding Cpu.StatsSummary}"
                                   Style="{StaticResource SmallMuted}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource Faint}" />

                        <Grid Grid.Row="4" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Cpu.Detail}" Style="{StaticResource PerfDetail}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Cpu.SecondaryDetail}"
                                       Style="{StaticResource PerfSubDetail}"
                                       TextAlignment="Right" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Memory -->
                <Border Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource PerfCard}"
                        Margin="0,0,0,14"
                        Background="{StaticResource PanelRaised}"
                        CornerRadius="8,17,10,15"
                        RenderTransformOrigin="0.5,0.5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" Background="{StaticResource Lime}" CornerRadius="2,1,2,1" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="MEMORY / PRESSURE" Style="{StaticResource PerfCardTitle}" Foreground="{StaticResource Lime}" />
                            </StackPanel>
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Padding="6,1" Background="Transparent" BorderBrush="{StaticResource Hairline}">
                                <TextBlock Text="{Binding MemoryMetaText}" Style="{StaticResource MonoText}" FontSize="8" Foreground="{StaticResource Faint}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,5,0,0">
                            <controls:AnimatedNumber Value="{Binding Memory.Value}"
                                                     ValueFormat="{Binding Memory.ValueFormat}"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     FontWeight="Bold"
                                                     FontSize="44"
                                                     LineHeight="44"
                                                     Foreground="{StaticResource Lime}" />
                            <TextBlock Text="%"
                                       Style="{StaticResource UnitText}"
                                       Foreground="{StaticResource Lime}"
                                       FontSize="14"
                                       Opacity="0.8" />
                        </StackPanel>

                        <controls:Sparkline Grid.Row="2"
                                            Values="{Binding Memory.History}"
                                            Stroke="{StaticResource Lime}"
                                            FixedMaximum="100"
                                            Height="68"
                                            Margin="0,5,0,2" />

                        <TextBlock Grid.Row="3"
                                   Text="{Binding Memory.StatsSummary}"
                                   Style="{StaticResource SmallMuted}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource Faint}" />

                        <Grid Grid.Row="4" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Memory.Detail}" Style="{StaticResource PerfDetail}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Memory.SecondaryDetail}"
                                       Style="{StaticResource PerfSubDetail}"
                                       TextAlignment="Right" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Disk -->
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource PerfCard}"
                        Margin="0,0,14,0"
                        CornerRadius="11,16,8,14"
                        RenderTransformOrigin="0.5,0.5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" Background="{StaticResource Pink}" CornerRadius="2,1,2,1" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="DISK / ACTIVITY" Style="{StaticResource PerfCardTitle}" Foreground="{StaticResource Pink}" />
                            </StackPanel>
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" Padding="6,1" Background="Transparent" BorderBrush="{StaticResource Hairline}">
                                <TextBlock Text="60 S" Style="{StaticResource MonoText}" FontSize="8" Foreground="{StaticResource Faint}" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,5,0,0">
                            <controls:AnimatedNumber Value="{Binding Disk.Value}"
                                                     ValueFormat="{Binding Disk.ValueFormat}"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     FontWeight="Bold"
                                                     FontSize="44"
                                                     LineHeight="44"
                                                     Foreground="{StaticResource Pink}" />
                            <TextBlock Text="%"
                                       Style="{StaticResource UnitText}"
                                       Foreground="{StaticResource Pink}"
                                       FontSize="14"
                                       Opacity="0.8" />
                        </StackPanel>

                        <controls:Sparkline Grid.Row="2"
                                            Values="{Binding Disk.History}"
                                            Stroke="{StaticResource Pink}"
                                            FixedMaximum="100"
                                            Height="68"
                                            Margin="0,5,0,2" />

                        <TextBlock Grid.Row="3"
                                   Text="{Binding Disk.StatsSummary}"
                                   Style="{StaticResource SmallMuted}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource Faint}" />

                        <Grid Grid.Row="4" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Disk.Detail}" Style="{StaticResource PerfDetail}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Disk.SecondaryDetail}"
                                       Style="{StaticResource PerfSubDetail}"
                                       TextAlignment="Right" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Network -->
                <Border Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource PerfCard}"
                        CornerRadius="8,13,10,16"
                        RenderTransformOrigin="0.5,0.5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" Background="{StaticResource Sky}" CornerRadius="2,1,2,1" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="NETWORK / FLOW" Style="{StaticResource PerfCardTitle}" Foreground="{StaticResource Sky}" />
                            </StackPanel>
                            <ComboBox Style="{StaticResource StickerComboBox}"
                                      ItemsSource="{Binding Network.NetworkAdapters}"
                                      SelectedItem="{Binding Network.SelectedAdapter, Mode=TwoWay}"
                                      HorizontalAlignment="Right"
                                      Width="178"
                                      ToolTip="{Binding Network.SelectedAdapter.Description}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,5,0,0">
                            <controls:AnimatedNumber Value="{Binding Network.Value}"
                                                     ValueFormat="{Binding Network.ValueFormat}"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     FontWeight="Bold"
                                                     FontSize="44"
                                                     LineHeight="44"
                                                     Foreground="{StaticResource Sky}" />
                            <TextBlock Text="{Binding Network.ValueUnit}"
                                       Style="{StaticResource UnitText}"
                                       Foreground="{StaticResource Sky}"
                                       FontSize="12"
                                       Opacity="0.8" />
                        </StackPanel>

                        <controls:Sparkline Grid.Row="2"
                                            Values="{Binding Network.History}"
                                            Stroke="{StaticResource Sky}"
                                            FixedMaximum="0"
                                            Height="68"
                                            Margin="0,5,0,2" />

                        <TextBlock Grid.Row="3"
                                   Text="{Binding Network.StatsSummary}"
                                   Style="{StaticResource SmallMuted}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource Faint}" />

                        <Grid Grid.Row="4" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Network.Detail}" Style="{StaticResource PerfDetail}" Foreground="{StaticResource Sky}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Network.SecondaryDetail}"
                                       Style="{StaticResource PerfSubDetail}"
                                       TextAlignment="Right" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
