<Window x:Class="PulsePal.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulsePal"
        Width="470"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Cocoa}"
        KeyDown="Window_KeyDown">
    <Border Background="{StaticResource Cocoa}"
            BorderBrush="{StaticResource CardStroke}"
            BorderThickness="2"
            CornerRadius="11,7,13,9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelSoft}"
                    BorderBrush="{StaticResource Hairline}"
                    BorderThickness="0,0,0,1.5"
                    CornerRadius="9,5,11,0"
                    Padding="18,10"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="EyebrowText"
                                   Text="PULSEPAL / CONFIRM"
                                   Style="{StaticResource Eyebrow}"
                                   Foreground="{StaticResource Amber}"
                                   FontSize="8.5" />
                        <TextBlock Text="a small, important question"
                                   Style="{StaticResource SmallMuted}"
                                   FontSize="10.5"
                                   Margin="0,1,0,0" />
                    </StackPanel>

                    <Button Style="{StaticResource WindowButton}"
                            Click="Close_Click"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTip="Close">
                        <Path Data="M3,3 L13,13 M13,3 L3,13"
                              Stroke="{StaticResource Muted}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="22,18,22,0">
                <TextBlock x:Name="TitleText"
                           Text="Are you sure?"
                           Style="{StaticResource PageTitle}"
                           FontSize="27"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText"
                           Text="This is the part where the app asks nicely."
                           Style="{StaticResource BodyText}"
                           FontSize="13"
                           Foreground="{StaticResource Muted}"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,8,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="22,18,22,20">
                <Button x:Name="CancelButton"
                        Style="{StaticResource GhostButton}"
                        Content="Leave it alone"
                        Click="Cancel_Click"
                        MinWidth="112"
                        Margin="0,0,9,0" />
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource AmberButton}"
                        Content="Confirm"
                        Click="Confirm_Click"
                        MinWidth="126" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
