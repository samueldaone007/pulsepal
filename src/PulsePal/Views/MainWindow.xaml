<Window x:Class="PulsePal.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="PulsePal"
        Width="1440"
        Height="940"
        MinWidth="1120"
        MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        Style="{StaticResource PulseWindow}"
        Icon="pack://application:,,,/Assets/PulsePal.ico"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DrawingBrush x:Key="DotGrid"
                      TileMode="Tile"
                      Viewport="0,0,28,28"
                      ViewportUnits="Absolute"
                      Viewbox="0,0,28,28"
                      ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#22A89684">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="1,1" RadiusX="0.9" RadiusY="0.9" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Border BorderBrush="#0F0B08" BorderThickness="1" Background="{StaticResource Cocoa}">
        <Grid>
            <Rectangle Fill="{StaticResource DotGrid}" Opacity="0.55" IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="65" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===================== Title / status strip ===================== -->
                <Border Grid.Row="0"
                        Background="{StaticResource CocoaDeep}"
                        BorderBrush="{StaticResource Hairline}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="38" Height="38" Margin="0,0,11,0">
                                <Border Background="{StaticResource Ink}"
                                        CornerRadius="7,5,8,6"
                                        Margin="2,3,0,0" />
                                <Border Background="{StaticResource PanelRaised}"
                                        BorderBrush="{StaticResource CardStroke}"
                                        BorderThickness="2"
                                        CornerRadius="7,5,8,6">
                                    <Path Data="{StaticResource IconPulse}"
                                          Stroke="{StaticResource Amber}"
                                          StrokeThickness="2.3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Stretch="Uniform"
                                          Margin="8" />
                                </Border>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="PulsePal"
                                               Style="{StaticResource BaseText}"
                                               FontSize="25"
                                               FontWeight="ExtraBold"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="."
                                               Style="{StaticResource BaseText}"
                                               FontSize="25"
                                               FontWeight="ExtraBold"
                                               Foreground="{StaticResource Amber}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="PERSONAL SYSTEM HEALTH / LOCAL"
                                           Style="{StaticResource Eyebrow}"
                                           FontSize="8.5"
                                           Margin="0,-1,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Mood readout: the little status strip that gives PulsePal a face. -->
                        <Border Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource PanelSoft}"
                                BorderBrush="{StaticResource Hairline}"
                                BorderThickness="1.5"
                                CornerRadius="10,6,9,7"
                                Padding="10,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Canvas Width="23" Height="23" Margin="0,0,8,0">
                                    <Ellipse Canvas.Left="1.5" Canvas.Top="1.5"
                                             Width="20" Height="20"
                                             Stroke="{Binding MoodAccent}"
                                             StrokeThickness="1.8" />
                                    <Path Data="M8,9.2 L8.2,9.2 M15.5,9.2 L15.7,9.2"
                                          Stroke="{StaticResource Cream}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Path Data="{Binding MoodMouth}"
                                          Stroke="{StaticResource Cream}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Canvas>
                                <StackPanel>
                                    <TextBlock Text="MOOD" Style="{StaticResource Eyebrow}" FontSize="8" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding MoodText}"
                                                   Style="{StaticResource BaseText}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{Binding MoodAccent}" />
                                        <TextBlock Text="{Binding MoodDetail}"
                                                   Style="{StaticResource SmallMuted}"
                                                   FontSize="10.5"
                                                   Margin="7,1,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource Chip}"
                                    Background="{StaticResource CreamSoft}"
                                    Margin="0,0,9,0"
                                    ToolTip="PulsePal never sends your data anywhere.">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCloudOff}"
                                          Stroke="{StaticResource Muted}"
                                          StrokeThickness="1.4"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Margin="0,0,5,0" />
                                    <TextBlock Text="LOCAL ONLY"
                                               Style="{StaticResource Eyebrow}"
                                               FontSize="9"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Lime}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding ClockText}"
                                               Style="{StaticResource MonoText}"
                                               FontSize="10"
                                               Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Minimize">
                                <Path Data="M2,8 L14,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                            </Button>
                            <Button Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="Maximize or restore">
                                <Path Data="M2.5,2.5 L13.5,2.5 L13.5,13.5 L2.5,13.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" />
                            </Button>
                            <Button Style="{StaticResource CloseWindowButton}" Click="Close_Click" ToolTip="Close">
                                <Path Data="M3,3 L13,13 M13,3 L3,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===================== Top tab strip ===================== -->
                <Grid Grid.Row="1" Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl ItemsSource="{Binding NavItems}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavTabButton}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{Binding Icon}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="16" Height="16"
                                              Stretch="Uniform"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconPulse}"
                              Stroke="{StaticResource Amber}"
                              StrokeThickness="1.8"
                              Width="19" Height="12"
                              Stretch="Uniform"
                              Margin="0,0,7,0"
                              ToolTip="{Binding LastTickText}" />
                    </StackPanel>

                    <Rectangle Grid.ColumnSpan="2"
                               Style="{StaticResource DashRule}"
                               VerticalAlignment="Bottom" />
                </Grid>

                <!-- ===================== Page content ===================== -->
                <ContentControl Grid.Row="2"
                                Content="{Binding CurrentPage}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Grid>
        </Grid>
    </Border>
</Window>
