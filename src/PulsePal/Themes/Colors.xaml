<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PulsePal's warm cocoa workshop palette. -->
    <Color x:Key="CocoaColor">#1E1814</Color>
    <Color x:Key="CocoaDeepColor">#17110D</Color>
    <Color x:Key="InkColor">#120D0A</Color>
    <Color x:Key="PanelColor">#2B221B</Color>
    <Color x:Key="PanelRaisedColor">#35291F</Color>
    <Color x:Key="PanelSoftColor">#241D17</Color>
    <Color x:Key="CreamColor">#F4E9D6</Color>
    <Color x:Key="MutedColor">#A89684</Color>
    <Color x:Key="FaintColor">#766656</Color>
    <Color x:Key="StrokeColor">#DCCBB1</Color>
    <Color x:Key="AmberColor">#FFB020</Color>
    <Color x:Key="LimeColor">#B8F25B</Color>
    <Color x:Key="SkyColor">#6EC6FF</Color>
    <Color x:Key="PinkColor">#FF6FA8</Color>
    <Color x:Key="AlertColor">#FF5A36</Color>

    <SolidColorBrush x:Key="Cocoa" Color="{StaticResource CocoaColor}" />
    <SolidColorBrush x:Key="CocoaDeep" Color="{StaticResource CocoaDeepColor}" />
    <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelRaised" Color="{StaticResource PanelRaisedColor}" />
    <SolidColorBrush x:Key="PanelSoft" Color="{StaticResource PanelSoftColor}" />
    <SolidColorBrush x:Key="Cream" Color="{StaticResource CreamColor}" />
    <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />
    <SolidColorBrush x:Key="CardStroke" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="Lime" Color="{StaticResource LimeColor}" />
    <SolidColorBrush x:Key="Sky" Color="{StaticResource SkyColor}" />
    <SolidColorBrush x:Key="Pink" Color="{StaticResource PinkColor}" />
    <SolidColorBrush x:Key="Alert" Color="{StaticResource AlertColor}" />

    <SolidColorBrush x:Key="AmberSoft" Color="#33FFB020" />
    <SolidColorBrush x:Key="LimeSoft" Color="#2EB8F25B" />
    <SolidColorBrush x:Key="SkySoft" Color="#2E6EC6FF" />
    <SolidColorBrush x:Key="PinkSoft" Color="#2EFF6FA8" />
    <SolidColorBrush x:Key="AlertSoft" Color="#33FF5A36" />
    <SolidColorBrush x:Key="CreamSoft" Color="#14F4E9D6" />
    <SolidColorBrush x:Key="CreamFaint" Color="#0BF4E9D6" />
    <SolidColorBrush x:Key="AmberWash" Color="#1FFF9F12" />
    <SolidColorBrush x:Key="PanelHover" Color="#3B2E22" />
    <SolidColorBrush x:Key="Inset" Color="#211A14" />
    <SolidColorBrush x:Key="Hairline" Color="#5A493B" />
    <SolidColorBrush x:Key="Transparent" Color="Transparent" />

</ResourceDictionary>
