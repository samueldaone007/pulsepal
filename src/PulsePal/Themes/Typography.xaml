<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fonts are embedded in the assembly, so PulsePal keeps its voice offline. -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/PulsePal;component/Assets/Fonts/#Bricolage Grotesque, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/PulsePal;component/Assets/Fonts/#JetBrains Mono, Consolas</FontFamily>

    <system:Double x:Key="DisplaySize" xmlns:system="clr-namespace:System;assembly=mscorlib">52</system:Double>
    <system:Double x:Key="NumberSize" xmlns:system="clr-namespace:System;assembly=mscorlib">42</system:Double>
    <system:Double x:Key="PageTitleSize" xmlns:system="clr-namespace:System;assembly=mscorlib">34</system:Double>
    <system:Double x:Key="SectionTitleSize" xmlns:system="clr-namespace:System;assembly=mscorlib">18</system:Double>

    <Style x:Key="BaseText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="Foreground" Value="{StaticResource Cream}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="DisplayText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{StaticResource DisplaySize}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="LineHeight" Value="50" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{StaticResource PageTitleSize}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="LineHeight" Value="34" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="{StaticResource SectionTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Cream}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>

    <Style x:Key="SmallMuted" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Cream}" />
    </Style>

    <Style x:Key="NumberText" TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource NumberSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="46" />
    </Style>

    <Style x:Key="BigNumber" TargetType="TextBlock" BasedOn="{StaticResource NumberText}">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="LineHeight" Value="40" />
    </Style>

    <Style x:Key="UnitText" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="3,0,0,6" />
    </Style>

</ResourceDictionary>
